FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY src /app/src

RUN useradd --create-home --uid 10002 ppm \
    && mkdir -p /app/exports /app/incoming \
    && chown -R ppm:ppm /app
USER ppm

EXPOSE 8765 8766
CMD ["python", "-m", "ppm.mcp.server"]
