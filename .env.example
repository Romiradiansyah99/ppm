# --- Database -----------------------------------------------------------------
PPM_DSN=postgresql://ppm:ppm_dev_password@127.0.0.1:5432/ppm
# Silo-enforcing read-only role used by retrieval paths (Phase 3). Change the
# password at deployment (scripts/RUNBOOK).
PPM_DSN_APP=postgresql://ppm_app:ppm_app_dev_password@127.0.0.1:5432/ppm

# --- Model residency (plan sections 6 and 9) ----------------------------------
# local = models on office hardware (default policy until a written residency
# position says otherwise). api = approved endpoint only.
PPM_RESIDENCY=local
# ollama | api | stub
# stub = deterministic dev-only pipeline check. NEVER ingest real data with it.
PPM_MODEL_PROVIDER=ollama
PPM_OLLAMA_HOST=http://127.0.0.1:11434
PPM_CHAT_MODEL=qwen3:8b
PPM_EMBED_MODEL=nomic-embed-text
PPM_EMBED_DIM=768
# api mode only:
PPM_API_BASE=
PPM_API_KEY=

# --- Ingest --------------------------------------------------------------------
PPM_REVIEW_CONFIDENCE_THRESHOLD=0.7
PPM_LOCATION_DEFAULT=Jakarta

# --- App and instrumentation ----------------------------------------------------
PPM_USER_LABEL=founder

# --- Observability (optional; self-hosted Langfuse) -----------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
