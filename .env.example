# --- Database -----------------------------------------------------------------
PPM_DSN=postgresql://ppm:ppm_dev_password@127.0.0.1:5432/ppm2
PPM_TEST_DSN=postgresql://ppm:ppm_dev_password@127.0.0.1:5432/ppm2_test
PPM_DB_POOL_MAX=10
# Used by docker-compose only; change before starting the public stack.
POSTGRES_PASSWORD=ppm_dev_password

# --- Public app ---------------------------------------------------------------
# Set to 1 in production. Demo seed accounts and password hints are disabled.
PPM_PUBLIC_MODE=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PPM_SESSION_SECRET=
PPM_TOOL_SECRET=
PPM_COOKIE_SECURE=0
PPM_SESSION_DAYS=30
PPM_DAILY_MESSAGE_LIMIT=50
PPM_MAX_INPUT_CHARS=6000

# --- Hermes Agent (private API servers, never browser-facing) -----------------
PPM_HERMES_ANALYST_URL=http://127.0.0.1:8642
PPM_HERMES_ANALYST_KEY=
PPM_HERMES_ADMIN_URL=http://127.0.0.1:8643
PPM_HERMES_ADMIN_KEY=
PPM_HERMES_MODEL=hermes-agent
PPM_HERMES_TIMEOUT=180
HERMES_IMAGE=nousresearch/hermes-agent:0.21.5
APP_DOMAIN=localhost
PPM_WEB_PORT=8501

# --- Residency and models -----------------------------------------------------
PPM_RESIDENCY=local
PPM_OLLAMA_HOST=http://127.0.0.1:11434
PPM_CHAT_MODEL=qwen2.5:3b
PPM_EMBED_MODEL=nomic-embed-text
PPM_EMBED_DIM=768
PPM_NUM_GPU=0
PPM_NUM_CTX=4096
PPM_TOP_K=4
PPM_MIN_SIMILARITY=0.25

# --- Analyst API (planning + codegen) -----------------------------------------
PPM_LLM_API_BASE=
PPM_LLM_API_KEY=
PPM_LLM_MODEL=deepseek/deepseek-v4.1-flash
PPM_LLM_TEMPERATURE=0
PPM_ANALYST_MAX_PARALLEL=4
PPM_ANALYST_TASK_TIMEOUT=120
PPM_ANALYST_ALLOW_CODE_EXECUTION=true
PPM_ANALYST_EGRESS_ACK=

# --- Files and corpus ---------------------------------------------------------
PPM_DOCUMENTS_DIR=exports/documents
PPM_INCOMING_DIR=incoming
PPM_CORPUS_MANIFEST=corpus/manifest.yaml
PPM_TAXONOMY_FILE=registry/template_taxonomy.yaml

# --- Dev-only seed accounts (ignored when PPM_PUBLIC_MODE=1) ------------------
PPM_SEED_SENIOR_USER=senior
PPM_SEED_SENIOR_PASSWORD=senior123
PPM_SEED_JUNIOR_USER=junior
PPM_SEED_JUNIOR_PASSWORD=junior123
